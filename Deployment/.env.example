# Copy these into your hosting dashboard (or export them locally). None are required for a local run.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0                       # 1 only on your own machine
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
DJANGO_SECURE_COOKIES=1              # behind HTTPS only (Render / Railway)
